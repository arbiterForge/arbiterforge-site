---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign indexed_pages = site.pages | sort: 'url' -%}
{%- for entry in indexed_pages -%}
  {%- if entry.sitemap or entry.layout == 'project-showcase' or entry.layout == 'arbiter-news-history' or entry.edition or entry.archive -%}
  <url><loc>{{ entry.url | absolute_url | xml_escape }}</loc></url>
  {%- endif -%}
{%- endfor %}
</urlset>
